{
  "manifest_version": 3,
  "name": "LingoLeaf — Okurken İngilizce",
  "version": "0.10.2",
  "description": "İngilizce okurken kelimelerini tanı, öğren ve gelişimini takip et.",
  "key": "",
  "minimum_chrome_version": "120",
  "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "permissions": ["storage", "contextMenus", "sidePanel", "identity", "alarms"],
  "optional_host_permissions": ["https://www.googleapis.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "LingoLeaf'i aç"},
  "side_panel": {"default_path": "panel.html"},
  "options_page": "panel.html",
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["phrases.js", "expressions.js", "core.js", "content.js"], "css": ["highlights.css"], "run_at": "document_idle"}],
  "commands": {"open-panel": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Seçimi LingoLeaf panelinde aç"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
